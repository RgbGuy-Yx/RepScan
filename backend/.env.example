NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repscan
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
APIFY_API_TOKEN=
# Set this to an Apify actor compatible with { startUrls: [{ url }], maxReviews } input.
APIFY_GOOGLE_REVIEWS_ACTOR_ID=
# Instagram Apify Actor (default: apify/instagram-scraper)
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
# Maximum posts/reels to retrieve per sync per account (default: 50)
INSTAGRAM_MAX_POSTS_PER_SYNC=50


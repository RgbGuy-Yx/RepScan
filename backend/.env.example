NODE_ENV=development
PORT=3000

# Database Configuration
# Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/repscan
# Supabase Pooler (Session mode): postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repscan
# DATABASE_SSL: Optional override ('true' or 'false'). Automatically enabled for Supabase / production hosts.
DATABASE_SSL=false
# Maximum pool connections (default: 10)
DATABASE_POOL_MAX=10
# Pool connection timeout in ms (default: 10000)
DATABASE_CONNECTION_TIMEOUT_MS=10000

AI_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
APIFY_API_TOKEN=
# Set this to an Apify actor compatible with { startUrls: [{ url }], maxReviews } input.
APIFY_GOOGLE_REVIEWS_ACTOR_ID=
# Instagram Apify Actor (default: apify/instagram-scraper)
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
# Maximum posts/reels to retrieve per sync per account (default: 50)
INSTAGRAM_MAX_POSTS_PER_SYNC=50
ENABLE_SCHEDULED_SCRAPING=false
SCRAPE_INTERVAL_MINUTES=60
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
GOOGLE_MAPS_API_KEY=

